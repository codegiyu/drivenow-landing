# Copy to `.env.local` and uncomment values you need.
# See README.md for provider-specific setup.

# --- Site (public) ---
# Canonical URL for SEO metadata (`lib/constants/texts.ts`)
# NEXT_PUBLIC_SITE_URL=https://drivenow.co.uk

# --- Waitlist ---
# Provider: `google_sheets` (default if unset) | `airtable`
# WAITLIST_PROVIDER=google_sheets

# Google Sheets (default provider) — webhook URL from Apps Script Web App deploy
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxx/exec
# Optional: sent as Authorization: Bearer <secret>
# GOOGLE_SHEETS_WEBHOOK_SECRET=

# Airtable (alternate provider)
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE_ID=
