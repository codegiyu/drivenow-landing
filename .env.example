# # Airtable waitlist integration
# # Personal access token with permission to create records in your target base/table
# AIRTABLE_API_KEY=pat_xxxxxxxxxxxxxxxxx

# # Airtable base ID, e.g. appXXXXXXXXXXXXXX
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# # Airtable table name or table ID that stores waitlist records
# AIRTABLE_TABLE_ID=Waitlist

# # Public site URL used for canonical and metadata URLs
# NEXT_PUBLIC_SITE_URL=https://drivenow.co.uk
